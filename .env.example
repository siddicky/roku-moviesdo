# Web catalog source. `fixture` (default) serves the original local catalog
# and generated artwork, so previews and local demos need no account.
# `bridge` proxies the Python server in ./server, which logs into movies.do.
CATALOG_SOURCE=fixture

# Used when CATALOG_SOURCE=bridge. No trailing path.
MOVIESDO_BRIDGE_URL=http://127.0.0.1:8766

# Read by the Python bridge (server/server.py), not by the browser.
# Required only for a live movies.do session.
MOVIESDO_EMAIL=
MOVIESDO_PASSWORD=

# Optional bridge bind (server/server.py defaults).
# MOVIESDO_HOST=0.0.0.0
# MOVIESDO_PORT=8766
