<?xml version="1.0" encoding="utf-8" ?>
<component name="CardItem" extends="Group">
    <script type="text/brightscript" uri="CardItem.brs" />
    <interface>
        <field id="itemContent" type="node" onChange="itemChanged" />
    </interface>
    <children>
        <Poster id="poster" width="246" height="138"
                loadDisplayMode="scaleToZoom" />
        <Rectangle id="ribbon" width="246" height="26" color="0x132733EE"
                   translation="[0,112]" />
        <Label id="title" width="246" height="26" translation="[6,110]"
               font="font:SmallSystemFont" color="0xCADCE1" horizAlign="left" vertAlign="center" />
        <Label id="badge" width="60" height="22" translation="[186,4]"
               font="font:SmallSystemFont" color="0x00ACC1" horizAlign="right" />
    </children>
</component>
