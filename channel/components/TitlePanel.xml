<?xml version="1.0" encoding="utf-8" ?>
<component name="TitlePanel" extends="Group">
    <script type="text/brightscript" uri="TitlePanel.brs" />
    <interface>
        <field id="serverUrl" type="string" />
        <field id="card" type="assocArray" />
        <field id="titleData" type="assocArray" onChange="dataSet" />
        <field id="playEpisode" type="assocArray" alwaysNotify="true" />
        <field id="closed" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <Rectangle id="backdrop" width="1920" height="1080" color="0x0B202C" />
        <Rectangle id="shade" width="760" height="1080" color="0x0B202CF2" />
        <Poster id="poster" width="560" height="315" translation="[100,120]"
                loadDisplayMode="scaleToZoom" />
        <Label id="title" translation="[100,470]" width="740" wrap="true"
               font="font:LargeSystemFont" color="0xFFFFFF" />
        <Label id="meta" translation="[100,570]" width="740"
               font="font:SmallSystemFont" color="0x00ACC1" />
        <Label id="desc" translation="[100,610]" width="740" height="190" wrap="true"
               font="font:SmallSystemFont" color="0xCADCE1" />
        <Button id="play" iconUri="" focusedIconUri="" translation="[100,820]" text="Play" showFocusFootprint="true"
                minWidth="240" />
        <Button id="favorite" iconUri="" focusedIconUri="" translation="[380,820]" text="Favorite"
                showFocusFootprint="true" minWidth="240" />
        <Button id="watchLater" iconUri="" focusedIconUri="" translation="[660,820]" text="Watch Later"
                showFocusFootprint="true" minWidth="240" />
        <Label id="episodesTitle" translation="[900,120]" font="font:MediumSystemFont"
               color="0xFFFFFF" text="Episodes" />
        <LabelList id="episodes" translation="[900,170]" itemSize="[880,64]"
                   itemSpacing="[0,8]" numRows="12" color="0xCADCE1"
                   focusedColor="0xFFFFFF" />
    </children>
</component>
